# Common personalized packages from CloseWRT-CI.
# Hardware-specific packages, especially MTK WiFi and acceleration packages,
# intentionally stay out of this fragment.

# Proxy and network tools
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y

# Optional utilities
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# DIY packages
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_default-settings-chn=y

# Explicit removals
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-gecoosac=n
CONFIG_PACKAGE_luci-app-mini-diskmanager=n
CONFIG_PACKAGE_luci-app-partexp=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-wolplus=n
CONFIG_PACKAGE_zram-swap=n
